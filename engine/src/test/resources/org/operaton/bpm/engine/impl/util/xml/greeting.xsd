    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="hello" type="xsd:string" minOccurs="1" maxOccurs="1"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>
