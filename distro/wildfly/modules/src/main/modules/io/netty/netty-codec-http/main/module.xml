<!-- overrides WildFly's own bundled module to fix CVE-2026-89044 -->
<module name="io.netty.netty-codec-http" xmlns="urn:jboss:module:1.9">
    <properties>
        <property name="jboss.api" value="private"/>
    </properties>

    <resources>
        <resource-root path="netty-codec-http-@version.netty.wildfly@.jar"/>
    </resources>

    <dependencies>
        <module name="io.netty.netty-common"/>
        <module name="io.netty.netty-buffer"/>
        <module name="io.netty.netty-transport"/>
        <module name="io.netty.netty-codec"/>
        <module name="io.netty.netty-handler"/>
    </dependencies>
</module>
