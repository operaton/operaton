# Vite mode used only by the accessibility report generator
# (`npm run a11y:report`, e2e/a11y-report.mjs).
#
# Why this exists: .env.development declares TWO backends while the gitignored
# .env.development.local usually declares one. The login page renders a backend
# <select> only when there is more than one (src/index.jsx), so the report's
# findings would depend on whether a developer happens to have a local override.
# Pinning the mode here makes the report reproducible on any machine and in CI.
VITE_BACKEND=[{"name": "Operaton", "url": "http://localhost:8084"}]

# The release banner is a fixed region that adds nothing to a scan and would
# otherwise differ between a local run and a release build.
VITE_HIDE_RELEASE_WARNING=true

VITE_AUTH_MODE=basic

# Present so the oauth2 login state can be exercised by intercepting
# config.json; unused while VITE_AUTH_MODE stays basic.
VITE_OAUTH_AUTHORITY=http://localhost:8888/realms/operaton
VITE_OAUTH_CLIENT_ID=operaton-web-apps
VITE_OAUTH_REDIRECT_URI=http://127.0.0.1:5173/
