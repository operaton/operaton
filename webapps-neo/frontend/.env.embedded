# Build used when webapps-neo is embedded into the Operaton (Run) distribution.
#
# Everything the SPA needs at runtime is served by the backend from
# {applicationPath}/config.json, driven by the application configuration and so
# by OPERATON_BPM_RUN_* environment variables. Nothing about the deployment is
# baked in here any more — in particular NOT the authentication mode, which is
# basic by default and switches to OAuth2 by itself once Spring Security client
# registrations are configured.
#
# The values below are only the fallback used if config.json cannot be reached.
VITE_BACKEND=[{"name": "Operaton", "url": ""}]
