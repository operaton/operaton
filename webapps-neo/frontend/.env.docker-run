ASSET_DIR=/var/www/html
# ASSET_DIR=/usr/share/nginx/html
APP_PREFIX=DOCKER_RUN_PLACEHOLDER_
# Substituted into config.json, so values are plain JSON — no shell escaping.
DOCKER_RUN_PLACEHOLDER_BACKEND=[{"name": "Dev Operaton", "url": "http://localhost:8084"}, {"name": "Dev c7", "url": "http://localhost:8088", "c7_mode": true}]
# basic | oauth2. With oauth2 the settings below must point at your identity
# provider; the browser performs the PKCE flow against it directly.
DOCKER_RUN_PLACEHOLDER_AUTH_MODE=basic
DOCKER_RUN_PLACEHOLDER_OAUTH_AUTHORITY=
DOCKER_RUN_PLACEHOLDER_OAUTH_CLIENT_ID=
DOCKER_RUN_PLACEHOLDER_OAUTH_REDIRECT_URI=
# Optional: URL of the runtime plugin manifest. Leave unset to use the default
# /plugins/plugins.json served from the app origin (mount plugins there).
DOCKER_RUN_PLACEHOLDER_PLUGINS_URL=
DOCKER_RUN_PLACEHOLDER_HIDE_RELEASE_WARNING=false
