<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xsd:schema SYSTEM "greeting-with-external-dtd.dtd">
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:tns="http://operaton.org/test/greeting-dtd"
            targetNamespace="http://operaton.org/test/greeting-dtd"
            elementFormDefault="qualified">
  <xsd:element name="greeting">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="hello" type="xsd:string" minOccurs="1" maxOccurs="1"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>
